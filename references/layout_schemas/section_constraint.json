{
  "name": "section_constraint",
  "description": "章节过渡页约束布局",
  "layout_mode": "constraint",
  "shapes": [
    {
      "role": "chapter_num",
      "type": "textbox",
      "region": {"left": "6%", "top": "25%", "width": "88%", "height": "18%"},
      "style": {"font_size": 96, "bold": true, "color": "#E5E7EB", "font_name": "Microsoft YaHei", "alignment": "left"},
      "content_source": "chapter_num"
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "chapter_num", "edge": "bottom", "offset": "3%"},
      "region": {"left": "6%", "width": "20%", "height": "0.8%"},
      "style": "accent-line"
    },
    {
      "role": "title",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "4%"},
      "region": {"left": "6%", "width": "80%", "height": "18%", "min_height": "12%"},
      "style": {"font_scale": 2.5, "bold": true, "color": "#1F2937", "font_name": "Microsoft YaHei", "alignment": "left"},
      "content_source": "title"
    },
    {
      "role": "subtitle",
      "type": "textbox",
      "attach": {"to": "title", "edge": "bottom", "offset": "2%"},
      "region": {"left": "6%", "width": "70%", "height": "10%", "min_height": "8%"},
      "style": {"font_scale": 1.0, "color": "#6B7280", "font_name": "Microsoft YaHei", "alignment": "left"},
      "content_source": "subtitle"
    }
  ]
}
