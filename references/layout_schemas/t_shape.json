{
  "name": "t_shape",
  "description": "T型布局：顶部横贯总览 + 下方双栏深潜",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "6%", "top": "4%", "width": "86%", "height": "10%"},
      "style": "heading-1",
      "content_source": "title",
      "adaptive": {"strategy": "shrink", "min_size": 28}
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "title", "edge": "bottom", "offset": "0%"},
      "region": {"left": "6%", "width": "11.3%", "height": "0.7%"},
      "style": "accent-line"
    },
    {
      "role": "top_bar",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "2%"},
      "region": {"left": "6%", "width": "86%", "height": "22%"},
      "style": {"font_size": 20, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "top_bar",
      "adaptive": {"strategy": "shrink", "max_size": 28, "min_size": 14}
    },
    {
      "role": "bottom_left",
      "type": "textbox",
      "attach": {"to": "top_bar", "edge": "bottom", "offset": "3%"},
      "region": {"left": "6%", "width": "40%", "height": "52%"},
      "style": "body",
      "content_source": "bottom_left",
      "adaptive": {"strategy": "shrink", "max_size": 32, "min_size": 12}
    },
    {
      "role": "bottom_right",
      "type": "textbox",
      "attach": {"to": "top_bar", "edge": "bottom", "offset": "3%"},
      "region": {"left": "52%", "width": "40%", "height": "52%"},
      "style": {"font_size": 16, "color": "#4B5563", "font_name": "Microsoft YaHei"},
      "content_source": "bottom_right",
      "adaptive": {"strategy": "shrink", "max_size": 28, "min_size": 12}
    }
  ]
}
