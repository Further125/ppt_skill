      "content_source": "header_row",
      "adaptive": {"strategy": "shrink", "max_size": 26, "min_size": 16}
    },
    {
      "role": "item_a",
      "type": "textbox",
      "attach": {"to": "header_row", "edge": "bottom", "offset": "2%"},
      "region": {"left": "6%", "width": "40%", "height": "60%"},
