      "region": {"left": "46.5%", "width": "7%", "height": "60%"},
      "style": {"font_size": 24, "bold": true, "color": "#9CA3AF", "font_name": "Microsoft YaHei", "alignment": "center"},
      "content": "VS"
    },
    {
      "role": "item_b",
      "type": "textbox",
      "attach": {"to": "header_row", "edge": "bottom", "offset": "2%"},
      "region": {"left": "54%", "width": "40%", "height": "60%"},
      "style": {"font_size": 16, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "item_b",
      "adaptive": {"strategy": "shrink", "max_size": 24, "min_size": 12}
