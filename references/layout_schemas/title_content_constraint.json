{
  "name": "title_content_constraint",
  "description": "标题+内容页约束布局",
  "layout_mode": "constraint",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "5%", "top": "5%", "width": "90%", "height": "10%"},
      "style": {"font_scale": 2.0, "bold": true, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "title"
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "title", "edge": "bottom", "offset": "1%"},
      "region": {"left": "5%", "width": "12%", "height": "0.7%"},
      "style": "accent-line"
    },
    {
      "role": "content",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "2%"},
      "region": {"left": "5%", "width": "90%", "height": "82%"},
      "style": {"max_font_size": 28, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "content"
    }
  ]
}
