      "attach": {"to": "card_2", "edge": "bottom", "offset": "3%"},
      "region": {"left": "35%", "width": "26%", "height": "36%"},
      "style": {"font_size": 18, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "card_5",
      "uniform_group": "cards",
      "adaptive": {"strategy": "shrink", "max_size": 26, "min_size": 14}
