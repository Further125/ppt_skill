{
  "name": "waterfall_layout",
  "description": "瀑布流布局：垂直堆叠卡片，信息密集仪表盘",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "6%", "top": "4%", "width": "86%", "height": "10%"},
      "style": "heading-1",
      "content_source": "title",
      "adaptive": {"strategy": "shrink", "min_size": 28}
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "title", "edge": "bottom", "offset": "0%"},
      "region": {"left": "6%", "width": "11.3%", "height": "0.7%"},
      "style": "accent-line"
    },
    {
      "role": "card_1",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "6%", "width": "26%", "height": "36%"},
      "style": {"font_size": 18, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "card_1",
      "uniform_group": "cards",
      "adaptive": {"strategy": "shrink", "max_size": 26, "min_size": 14}
    },
    {
      "role": "card_2",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "35%", "width": "26%", "height": "36%"},
      "style": {"font_size": 18, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "card_2",
      "uniform_group": "cards",
      "adaptive": {"strategy": "shrink", "max_size": 26, "min_size": 14}
    },
    {
      "role": "card_3",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "64%", "width": "26%", "height": "36%"},
      "style": {"font_size": 18, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "card_3",
      "uniform_group": "cards",
      "adaptive": {"strategy": "shrink", "max_size": 26, "min_size": 14}
    },
    {
      "role": "card_4",
      "type": "textbox",
      "attach": {"to": "card_1", "edge": "bottom", "offset": "3%"},
      "region": {"left": "6%", "width": "26%", "height": "36%"},
      "style": {"font_size": 18, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "card_4",
      "uniform_group": "cards",
      "adaptive": {"strategy": "shrink", "max_size": 26, "min_size": 14}
