{
  "name": "image_text_split_constraint",
  "description": "左图右文约束布局：图片按宽高比计算高度，文字自适应",
  "layout_mode": "constraint",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "5%", "top": "5%", "width": "90%", "height": "10%"},
      "style": {"font_scale": 2.2, "bold": true, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "title"
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "title", "edge": "bottom", "offset": "1%"},
      "region": {"left": "5%", "width": "12%", "height": "0.7%"},
      "style": "accent-line"
    },
    {
      "role": "image",
      "type": "image",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "5%", "width": "30%", "height": "55%"},

      "content_source": "image"
    },
    {
      "role": "content",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "40%", "width": "55%", "height": "50%"},
      "style": {"font_scale": 1.0, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "content"
    }
  ]
}
