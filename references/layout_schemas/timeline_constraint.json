{
  "name": "timeline_constraint",
  "description": "时间线约束布局：标题自动编排 + timeline 占位",
  "layout_mode": "constraint",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "5%", "top": "5%", "width": "90%", "height": "10%"},
      "style": {"font_scale": 2.2, "bold": true, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "title"
    },
    {
      "role": "timeline_placeholder",
      "type": "textbox",
      "attach": {"to": "title", "edge": "bottom", "offset": "3%"},
      "region": {"left": "5%", "width": "90%", "height": "55%", "min_height": "50%"},
      "style": {"font_size": 8, "color": "#FFFFFF", "font_name": "Microsoft YaHei"},
      "content": "__TIMELINE__"
    }
  ]
}
