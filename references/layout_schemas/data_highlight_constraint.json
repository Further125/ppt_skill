{
  "name": "data_highlight_constraint",
  "description": "数据亮点约束布局",
  "layout_mode": "constraint",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "6%", "top": "6.7%", "width": "86%", "height": "12%"},
      "style": {"font_scale": 2.0, "bold": true, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "title"
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "title", "edge": "bottom", "offset": "1%"},
      "region": {"left": "6%", "width": "11.3%", "height": "0.7%"},
      "style": "accent-line"
    },
    {
      "role": "big_number",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "5%"},
      "region": {"left": "6%", "width": "50%", "height": "35%", "min_height": "20%"},
      "style": {"font_scale": 3.5, "bold": true, "color": "#3B82F6", "font_name": "Microsoft YaHei", "alignment": "left"},
      "content_source": "big_number"
    },
    {
      "role": "description",
      "type": "textbox",
      "attach": {"to": "big_number", "edge": "bottom", "offset": "3%"},
      "region": {"left": "6%", "width": "80%", "height": "35%", "min_height": "15%"},
      "style": {"font_scale": 1.1, "color": "#4B5563", "font_name": "Microsoft YaHei", "alignment": "left"},
      "content_source": "description"
    }
  ]
}
