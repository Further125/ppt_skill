{
  "name": "process_constraint",
  "description": "流程页约束布局：标题自动编排 + process 占位",
  "layout_mode": "constraint",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "5%", "top": "5%", "width": "90%", "height": "10%"},
      "style": {"font_scale": 2.2, "bold": true, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "title"
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "title", "edge": "bottom", "offset": "1%"},
      "region": {"left": "5%", "width": "12%", "height": "0.7%"},
      "style": "accent-line"
    },
    {
      "role": "process_placeholder",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "5%", "width": "90%", "height": "78%", "min_height": "70%"},
      "style": {"font_size": 8, "color": "#FFFFFF", "font_name": "Microsoft YaHei"},
      "content": "__PROCESS__"
    }
  ]
}
