{
  "name": "primary_secondary",
  "description": "主次结合布局：左侧大卡 + 右侧两小卡堆叠",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "6%", "top": "4%", "width": "86%", "height": "10%"},
      "style": "heading-1",
      "content_source": "title",
      "adaptive": {"strategy": "shrink", "min_size": 28}
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "title", "edge": "bottom", "offset": "0%"},
      "region": {"left": "6%", "width": "11.3%", "height": "0.7%"},
      "style": "accent-line"
    },
    {
      "role": "primary",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "6%", "width": "58%", "height": "75%"},
      "style": "body",
      "content_source": "primary_content",
      "adaptive": {"strategy": "shrink", "max_size": 36, "min_size": 14}
    },
    {
      "role": "secondary_1",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "67%", "width": "27%", "height": "36%"},
      "style": {"font_size": 16, "color": "#4B5563", "font_name": "Microsoft YaHei"},
      "content_source": "secondary_1",
      "adaptive": {"strategy": "shrink", "max_size": 24, "min_size": 12}
    },
    {
      "role": "secondary_2",
      "type": "textbox",
      "attach": {"to": "secondary_1", "edge": "bottom", "offset": "3%"},
      "region": {"left": "67%", "width": "27%", "height": "36%"},
      "style": {"font_size": 16, "color": "#4B5563", "font_name": "Microsoft YaHei"},
      "content_source": "secondary_2",
      "adaptive": {"strategy": "shrink", "max_size": 24, "min_size": 12}
    }
  ]
}
