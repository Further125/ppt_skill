{
  "name": "two_column_constraint",
  "description": "双栏对比约束布局",
  "layout_mode": "constraint",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "5%", "top": "5%", "width": "90%", "height": "10%"},
      "style": {"font_scale": 2.0, "bold": true, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "title"
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "title", "edge": "bottom", "offset": "1%"},
      "region": {"left": "5%", "width": "12%", "height": "0.7%"},
      "style": "accent-line"
    },
    {
      "role": "divider",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "49.85%", "width": "0.15%", "height": "78%"},
      "style": {"fill": "#E5E7EB"}
    },
    {
      "role": "left_content",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "5%", "width": "44%", "height": "78%"},
      "style": {"max_font_size": 32, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "left_content",
      "uniform_group": "body"
    },
    {
      "role": "right_content",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "51%", "width": "44%", "height": "78%"},
      "style": {"max_font_size": 32, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "right_content",
      "uniform_group": "body"
    }
  ]
}
