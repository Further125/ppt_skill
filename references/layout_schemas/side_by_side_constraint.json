{
  "name": "side_by_side_constraint",
  "description": "左右水平并排列约束布局：测试 left/right attach",
  "layout_mode": "constraint",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "5%", "top": "5%", "width": "90%", "height": "10%"},
      "style": {"font_scale": 2.0, "bold": true, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "title"
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "title", "edge": "bottom", "offset": "1%"},
      "region": {"left": "5%", "width": "12%", "height": "0.7%"},
      "style": "accent-line"
    },
    {
      "role": "left_panel",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "3%"},
      "region": {"left": "5%", "width": "42%", "height": "78%"},
      "style": {"max_font_size": 28, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "left_panel",
      "uniform_group": "body"
    },
    {
      "role": "right_panel",
      "type": "textbox",
      "attach": {"to": "left_panel", "edge": "right", "offset": "6%"},
      "region": {"top": "19%", "width": "42%", "height": "78%"},
      "style": {"max_font_size": 28, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "right_panel",
      "uniform_group": "body"
    }
  ]
}
