{
  "name": "hero_top_constraint",
  "description": "Hero Top 约束求解布局：顶部英雄区 + 下方卡片，支持 font_scale",
  "layout_mode": "constraint",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "6%", "top": "4%", "width": "86%", "height": "10%"},
      "style": {"font_size": 36, "bold": true, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "title"
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "title", "edge": "bottom", "offset": "0%"},
      "region": {"left": "6%", "width": "11.3%", "height": "0.7%"},
      "style": "accent-line"
    },
    {
      "role": "hero",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "2%"},
      "region": {"left": "6%", "width": "86%", "height": "40%"},
      "style": {"font_scale": 1.8, "color": "#1F2937", "font_name": "Microsoft YaHei"},
      "content_source": "hero_content"
    },
    {
      "role": "card_1",
      "type": "textbox",
      "attach": {"to": "hero", "edge": "bottom", "offset": "3%"},
      "region": {"left": "6%", "width": "20%", "height": "40%"},
      "style": {"font_scale": 1.0, "color": "#4B5563", "font_name": "Microsoft YaHei"},
      "content_source": "card_1",
      "uniform_group": "cards"
    },
    {
      "role": "card_2",
      "type": "textbox",
      "attach": {"to": "hero", "edge": "bottom", "offset": "3%"},
      "region": {"left": "28%", "width": "20%", "height": "40%"},
      "style": {"font_scale": 1.0, "color": "#4B5563", "font_name": "Microsoft YaHei"},
      "content_source": "card_2",
      "uniform_group": "cards"
    },
    {
      "role": "card_3",
      "type": "textbox",
      "attach": {"to": "hero", "edge": "bottom", "offset": "3%"},
      "region": {"left": "50%", "width": "20%", "height": "40%"},
      "style": {"font_scale": 1.0, "color": "#4B5563", "font_name": "Microsoft YaHei"},
      "content_source": "card_3",
      "uniform_group": "cards"
    },
    {
      "role": "card_4",
      "type": "textbox",
      "attach": {"to": "hero", "edge": "bottom", "offset": "3%"},
      "region": {"left": "72%", "width": "20%", "height": "40%"},
      "style": {"font_scale": 1.0, "color": "#4B5563", "font_name": "Microsoft YaHei"},
      "content_source": "card_4",
      "uniform_group": "cards"
    }
  ]
}
