{
  "name": "cover",
  "description": "封面页（声明式schema版本）",
  "shapes": [
    {
      "role": "bg",
      "type": "shape",
      "shape_type": "rectangle",
      "region": "full",
      "style": {"fill": "#0B1F3A"}
    },
    {
      "role": "accent_bar",
      "type": "shape",
      "shape_type": "rectangle",
      "region": {"left": "5%", "top": "35%", "width": "1%", "height": "30%"},
      "style": {"fill": "#3B82F6"}
    },
    {
      "role": "title",
      "type": "textbox",
      "attach": {"to": "accent_bar", "edge": "right", "offset": "2%"},
      "region": {"top": "35%", "width": "80%", "height": "15%"},
      "style": {"font_size": 54, "bold": true, "color": "#FFFFFF", "font_name": "Microsoft YaHei", "alignment": "left"},
      "content_source": "title",
      "adaptive": {"strategy": "shrink", "max_size": 60, "min_size": 32}
    },
    {
      "role": "subtitle",
      "type": "textbox",
      "attach": {"to": "title", "edge": "bottom", "offset": "1%"},
      "region": {"left": "8%", "width": "80%", "height": "10%"},
      "style": {"font_size": 28, "bold": false, "color": "#AABBCC", "font_name": "Microsoft YaHei", "alignment": "left"},
      "content_source": "subtitle",
      "adaptive": {"strategy": "shrink", "max_size": 32, "min_size": 16}
    },
    {
      "role": "date",
      "type": "textbox",
      "attach": {"to": "subtitle", "edge": "bottom", "offset": "2%"},
      "region": {"left": "8%", "width": "40%", "height": "8%"},
      "style": {"font_size": 20, "color": "#888888", "font_name": "Microsoft YaHei"},
      "content_source": "date"
    }
  ]
}
