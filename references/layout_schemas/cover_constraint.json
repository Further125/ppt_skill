{
  "name": "cover_constraint",
  "description": "封面约束布局",
  "layout_mode": "constraint",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "6%", "top": "30%", "width": "86%", "height": "20%"},
      "style": {"font_scale": 3.0, "bold": true, "color": "#1F2937", "font_name": "Microsoft YaHei", "alignment": "left"},
      "content_source": "title"
    },
    {
      "role": "subtitle",
      "type": "textbox",
      "attach": {"to": "title", "edge": "bottom", "offset": "3%"},
      "region": {"left": "6%", "width": "70%", "height": "10%", "min_height": "8%"},
      "style": {"font_scale": 1.2, "color": "#6B7280", "font_name": "Microsoft YaHei", "alignment": "left"},
      "content_source": "subtitle"
    },
    {
      "role": "meta",
      "type": "textbox",
      "attach": {"to": "subtitle", "edge": "bottom", "offset": "5%"},
      "region": {"left": "6%", "width": "50%", "height": "15%", "min_height": "10%"},
      "style": {"font_scale": 0.9, "color": "#9CA3AF", "font_name": "Microsoft YaHei", "alignment": "left"},
      "content_source": "meta"
    }
  ]
}
