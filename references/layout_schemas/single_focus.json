{
  "name": "single_focus",
  "description": "单焦点布局：中央大数字/大图 + 四周辅助说明",
  "shapes": [
    {
      "role": "title",
      "type": "textbox",
      "region": {"left": "6%", "top": "4%", "width": "86%", "height": "10%"},
      "style": "heading-1",
      "content_source": "title",
      "adaptive": {"strategy": "shrink", "min_size": 28}
    },
    {
      "role": "accent_line",
      "type": "shape",
      "shape_type": "rectangle",
      "attach": {"to": "title", "edge": "bottom", "offset": "0%"},
      "region": {"left": "6%", "width": "11.3%", "height": "0.7%"},
      "style": "accent-line"
    },
    {
      "role": "focus",
      "type": "textbox",
      "attach": {"to": "accent_line", "edge": "bottom", "offset": "5%"},
      "region": {"left": "20%", "width": "60%", "height": "45%"},
      "style": {"font_size": 72, "bold": true, "color": "#3B82F6", "font_name": "Microsoft YaHei", "alignment": "center"},
      "content_source": "focus",
      "adaptive": {"strategy": "shrink", "max_size": 96, "min_size": 36}
    },
    {
      "role": "caption",
      "type": "textbox",
      "attach": {"to": "focus", "edge": "bottom", "offset": "2%"},
      "region": {"left": "20%", "width": "60%", "height": "8%"},
      "style": {"font_size_ref": "focus", "font_size_ratio": 0.22, "color": "#6B7280", "font_name": "Microsoft YaHei", "alignment": "center"},
      "content_source": "caption"
    },
    {
      "role": "details",
      "type": "textbox",
      "attach": {"to": "caption", "edge": "bottom", "offset": "4%"},
      "region": {"left": "6%", "width": "86%", "height": "30%"},
      "style": {"font_size_ref": "focus", "font_size_ratio": 0.28, "color": "#374151", "font_name": "Microsoft YaHei"},
      "content_source": "details"
    }
  ]
}
